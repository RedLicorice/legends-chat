# ── External services ────────────────────────────────────────────────────────
# Point to your Postgres and Redis — no bundled DB in the prod image.
DATABASE_URL=postgres://legends:CHANGE_ME@db.example.com:5432/legends
REDIS_URL=redis://redis.example.com:6379

# ── Auth secrets ─────────────────────────────────────────────────────────────
# generate: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400

# ── At-rest encryption ────────────────────────────────────────────────────────
# generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=CHANGE_ME

# ── App ───────────────────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://chat.example.com
NEXT_PUBLIC_WS_URL=https://chat.example.com
NODE_ENV=production

# Host port nginx listens on (default 80)
# APP_PORT=80

# ── Web Push / VAPID ─────────────────────────────────────────────────────────
# generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Telegram bot (optional) ───────────────────────────────────────────────────
TOTP_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
# Bot @username without leading @ — surfaced on /login as the t.me/<username> link
TELEGRAM_BOT_USERNAME=

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
