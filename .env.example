# Postgres
DATABASE_URL=postgres://legends:legends@localhost:5432/legends

# Redis
REDIS_URL=redis://localhost:6379

# JWT signing keys (generate strong random values for prod)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32bytes-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32bytes-min
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=86400

# Server-side at-rest encryption master key (32 bytes, base64)
# generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=ZGV2LW1hc3Rlci1rZXktY2hhbmdlLW1lLXBsZWFzZS0zMmJ5dGVzCg==

# Web Push (VAPID) - generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram bot
TELEGRAM_BOT_TOKEN=
APP_PUBLIC_URL=http://localhost:3000

# ngrok (optional — enables mobile testing via a public tunnel)
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Static domain — URL stays the same across restarts (free: dashboard.ngrok.com/domains)
NGROK_DOMAIN=

# Service URLs
WEB_URL=http://localhost:3000
WS_URL=http://localhost:3001
WS_PORT=3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# TOTP 2FA — 32-byte hex key for AES-256-GCM at-rest encryption of TOTP secrets
# generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Email / SMTP (optional — falls back to console log in dev when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# Jane bot — welcome bot (register a bot in the admin panel, paste its token here)
JANE_BOT_TOKEN=
# Optional webhook mode for Jane
JANE_WEBHOOK_URL=
JANE_WEBHOOK_PORT=3010

# Chaos bot — two autonomous instances
# Register two separate bots in the admin panel; paste their tokens here
CHAOS_ALPHA_TOKEN=
CHAOS_BETA_TOKEN=
# Comma-separated topic IDs each instance should post to
CHAOS_ALPHA_TOPICS=
CHAOS_BETA_TOPICS=
# Posting interval range in ms (defaults: 15000–60000)
CHAOS_MIN_DELAY_MS=15000
CHAOS_MAX_DELAY_MS=60000
