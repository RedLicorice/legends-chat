{
  "name": "legends-chat",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @legends/db generate",
    "db:migrate": "pnpm --filter @legends/db migrate",
    "db:seed": "pnpm --filter @legends/db seed",
    "dev:login": "tsx scripts/dev-login.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.7.5",
    "@ngrok/ngrok": "^1.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
